# The repo holds the scripts, Project docs, templates, design system and every console
# version. The client's exports, the runs built from them and local builds stay in OneDrive.

# The client's exports for each close, and the older local data store. No trailing slash on inputs,
# so a symlink named inputs is ignored too, as well as a folder.
/inputs
data/
status/

# Build output: the packaged Project folders and each month's runs and consoles.
out/

# Reference material: The client's documents and reviewer exports. Only the README is kept;
# Chris's two August reports are in docs/spec/.
references/*
!references/README.md

# Office and export formats never belong in the repo.
*.xls
*.xlsx
*.xlsm
*.pptx
*.docx
*.pdf
*.eml

# System and Python files
.DS_Store
desktop.ini
__pycache__/
*.pyc
~$*
